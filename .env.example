# Copy to .env and adjust as needed.

SECRET_KEY=change-me-to-a-random-string

ADMIN_USERNAME=admin
# Leave ADMIN_PASSWORD unset to auto-generate one (printed on first run).
ADMIN_PASSWORD=

# Leave API_KEY unset to auto-generate one (printed on first run, viewable in Admin > Settings).
API_KEY=

MODEL_NAME=buffalo_s
DETECTION_SIZE=640

MATCH_THRESHOLD=0.40
REVIEW_MARGIN=0.07

BLUR_VARIANCE_MIN=60.0
FACE_AREA_MIN_RATIO=0.02
FACE_AREA_MAX_RATIO=0.85
EYE_MOVEMENT_MIN=1.5
REQUIRE_LIVENESS_DEFAULT=true
